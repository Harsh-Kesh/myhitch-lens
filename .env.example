# --- Database (Postgres) ---
# Local dev via docker-compose (see docker-compose.yml):
DATABASE_URL="postgresql://lens:lens@localhost:5432/myhitch_lens?schema=public"
# Or a hosted Postgres (Neon/Supabase/RDS): paste its connection string here.

# --- Auth (NextAuth / Auth.js v5) ---
AUTH_SECRET="generate-with:  npx auth secret"
AUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Anthropic Claude (AI suite) ---
ANTHROPIC_API_KEY=""

# --- Object storage (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
