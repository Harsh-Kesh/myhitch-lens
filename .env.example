# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# We use a standard Postgres database, so any provider works (Supabase, Neon, …).
#
# --- Supabase (target for production) ---
# From Supabase: Project Settings → Database → Connection string.
# Use the POOLED connection (Transaction mode, port 6543) for the app, and add
# ?pgbouncer=true so Prisma disables prepared statements:
#   DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the DIRECT connection (port 5432) for running migrations:
#   DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# --- Local / Neon (current dev) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# =============================================================================
# Auth (NextAuth / Auth.js v5)
# =============================================================================
AUTH_SECRET="generate-with:  npx auth secret"
# Local: http://localhost:3001  |  Production: the Railway public URL
AUTH_URL="http://localhost:3001"

# =============================================================================
# Stripe (Phase 5 — test mode for now)
# =============================================================================
# Lens's OWN Stripe account: bills the paid plans (Checkout, Billing Portal). Create the
# products and prices once with:  npx tsx --env-file=.env scripts/setupStripePlans.ts
STRIPE_SECRET_KEY=""
# Signing secret of the Stripe webhook endpoint  <site>/api/stripe/billing-webhook  (one endpoint
# and one secret per deployment: dev and production each get their own).
STRIPE_BILLING_WEBHOOK_SECRET=""
# Publishable key (pk_test_ / pk_live_) of the SAME Lens Stripe account, for buying and changing
# plans inside the MYHitch app (Stripe PaymentSheet). Without it the app's in-app billing answers
# 503 billing_not_configured; the web Checkout and Billing Portal keep working.
STRIPE_PUBLISHABLE_KEY=""
# TEST MODE ONLY. When "true", the package buttons on the Author dashboard switch plans with NO
# payment so each package's benefits can be tried. Leave unset in production; it is also refused
# automatically whenever STRIPE_SECRET_KEY is a live key.
ALLOW_FREE_PLAN_SWITCH=""
# Legacy, unused since the old donation webhook was removed.
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# =============================================================================
# ABN Lookup (abr.business.gov.au) — free, register at:
#   https://abr.business.gov.au/Tools/WebServices
# Without this set, ABN fields still get checksum-validated but skip the live
# ABR lookup (so an invalid-but-checksum-passing ABN won't be caught).
# =============================================================================
ABN_LOOKUP_GUID=""

# =============================================================================
# AI suite (Phase 4 — pending provider key)
# =============================================================================
ANTHROPIC_API_KEY=""
# or OPENAI_API_KEY=""

# =============================================================================
# Media storage (Supabase Storage — same project as the database)
# =============================================================================
# From Supabase: Project Settings → Data API → Project URL / service_role key.
# The service_role key bypasses Row Level Security — server-only, never expose
# to the client. Without these two set, uploads fall back to local disk
# (public/uploads), which is fine for local dev but is WIPED on every Railway
# redeploy — set these in production.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# Storage bucket name (create it once in Supabase → Storage). Must be PUBLIC
# so uploaded article media is readable without signed URLs.
SUPABASE_STORAGE_BUCKET="media"

# =============================================================================
# MYHitch Business portal (SSO) — see docs/LENS_SSO_AND_STRIPE_INTEGRATION_GUIDE.md
# =============================================================================
# Public: the portal's origin. Inlined at build time, so REBUILD after changing.
# Local: http://localhost:3000  |  Production: https://businessauth.myhitch.com.au
NEXT_PUBLIC_PORTAL_URL=""
# The PORTAL's Supabase project (NOT Lens's own SUPABASE_URL above). Server-only.
# Lens only redeems SSO tickets and reads profile / business / Stripe-account
# columns from it. The service_role key bypasses RLS — never expose to the client.
PORTAL_SUPABASE_URL=""
PORTAL_SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================================
# Shared Stripe (portal-owned Connect accounts) — see docs/LENS_SSO_AND_STRIPE_INTEGRATION_GUIDE.md
# =============================================================================
# Secret key (sk_ or restricted rk_) of the PORTAL's Stripe platform — the one that
# owns the authors' connected accounts. NOT the same account as STRIPE_SECRET_KEY
# above. Must be the same mode (test/live) as the portal. Server-only.
PORTAL_STRIPE_SECRET_KEY=""

# =============================================================================
# Copyleaks — automated originality review (plagiarism scan + AI-content check)
# =============================================================================
# The Copyleaks account email and its API key (dashboard.copyleaks.com -> API access).
COPYLEAKS_EMAIL="suranp@myhitch.com.au"
COPYLEAKS_API_KEY="96a9ff4a-1cb8-4862-926b-7c4fb83a533b"
# Calls use Copyleaks' sandbox (mock data, no credits) unless this is exactly "false". Set it to
# "false" in production.
COPYLEAKS_SANDBOX="true"
# Public base URL Copyleaks calls back with the result (<base>/api/copyleaks/webhook/...). Defaults to
# AUTH_URL. Copyleaks can't reach localhost: when testing locally, use a tunnel URL here (ngrok etc.).
COPYLEAKS_WEBHOOK_BASE_URL=""
# An article passes when its combined score (0-100, higher is better) reaches this.
REVIEW_PASS_SCORE="70"
# How the combined score is weighted: plagiarism (originality) vs AI-written text.
REVIEW_WEIGHT_PLAGIARISM="0.7"
REVIEW_WEIGHT_AI="0.3"

# Model for the legal and compliance screening shown before an article is submitted. Defaults to
# claude-opus-5-5 (more accurate than the cheap model the other writing helpers use).
LEGAL_REVIEW_MODEL=""
